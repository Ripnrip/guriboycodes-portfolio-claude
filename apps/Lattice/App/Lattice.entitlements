<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The vault is a folder the user picks, reopened later from a security-scoped
	     bookmark. Phase 2 uses this; it is declared now so the entitlement does not
	     change after the app is first signed. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Shared with the widget and share extensions added in Phase 3. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.codes.guriboy.lattice</string>
	</array>
</dict>
</plist>
